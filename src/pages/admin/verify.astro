---
import Layout from '../../layouts/Layout.astro';
import { prisma } from '../../lib/prisma';
import { createSession } from '../../lib/auth';

let error = '';
const email = Astro.url.searchParams.get('email') || '';

if (!email) {
  return Astro.redirect('/login');
}

if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const otp = data.get('otp')?.toString();

  if (otp) {
    const user = await prisma.user.findUnique({ where: { email } });
    
    if (user && user.otp === otp && user.otpExpiresAt && user.otpExpiresAt > new Date()) {
      // Clear OTP
      await prisma.user.update({
        where: { id: user.id },
        data: { otp: null, otpExpiresAt: null }
      });

      // Create session
      const session = await createSession(user.id);
      Astro.cookies.set('auth_session', session.id, {
        path: '/',
        httpOnly: true,
        sameSite: 'lax',
        expires: session.expiresAt
      });
      return Astro.redirect('/admin/dashboard');
    } else {
      error = 'Codice di verifica non valido o scaduto';
    }
  } else {
    error = 'Inserisci il codice di verifica';
  }
}
---

<Layout title="Verifica Amministratore - Albergobanne">
  <div class="auth-container container">
    <div class="auth-card">
      <h1>Verifica Amministratore</h1>
      <p>Abbiamo inviato un codice di verifica a 6 cifre a <strong>{email}</strong>.</p>
      
      {error && <div class="error-alert">{error}</div>}
      
      <form method="POST" class="auth-form">
        <div class="form-group">
          <label for="otp">Codice di Verifica</label>
          <input type="text" id="otp" name="otp" required placeholder="123456" autocomplete="one-time-code" />
        </div>
        <button type="submit" class="btn">Verifica e Accedi</button>
      </form>
    </div>
  </div>
</Layout>

<style>
  .auth-container {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 70vh;
    padding: 2rem;
  }
  .auth-card {
    background: var(--surface);
    padding: 3rem;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    border: 1px solid var(--border);
    width: 100%;
    max-width: 450px;
    text-align: center;
  }
  .auth-card h1 {
    font-size: 2rem;
    color: var(--primary);
    margin-bottom: 0.5rem;
  }
  .auth-card p {
    color: var(--text-muted);
    margin-bottom: 2rem;
  }
  .error-alert {
    background: #fee2e2;
    color: #991b1b;
    padding: 1rem;
    border-radius: 4px;
    margin-bottom: 1.5rem;
  }
  .auth-form {
    text-align: left;
  }
  .form-group {
    margin-bottom: 1.5rem;
  }
  .form-group label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 600;
  }
  .form-group input {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    text-align: center;
    font-size: 1.5rem;
    letter-spacing: 0.25rem;
  }
  .btn {
    width: 100%;
    padding: 1rem;
    font-size: 1.1rem;
  }
</style>
