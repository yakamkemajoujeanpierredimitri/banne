---
import Layout from '../../layouts/Layout.astro';
import AdminReservationsManager from '../../components/AdminReservationsManager.jsx';
import { prisma } from '../../lib/prisma';

// Calculate total reservations
const totalReservations = await prisma.booking.count();

// Calculate pending payments
const pendingPayments = await prisma.booking.count({
    where: { status: 'Pending' }
});

// Calculate occupancy rate (active bookings today / total rooms)
const totalRooms = await prisma.room.count();
const activeBookings = await prisma.booking.count({
    where: { 
        status: { not: 'Cancelled' },
        checkInDate: { lte: new Date() },
        checkOutDate: { gte: new Date() }
    }
});
const occupancyRate = totalRooms > 0 ? Math.round((activeBookings / totalRooms) * 100) : 0;
---

<Layout title="Pannello di Controllo - Albergobanne">
    <div class="container admin-layout">
        <aside class="admin-sidebar">
            <h2 class="sidebar-title">Menu Amministrazione</h2>
            <nav class="sidebar-nav">
                <a href="/admin/dashboard" class="sidebar-link active">Prenotazioni</a>
                <a href="/admin/rooms" class="sidebar-link">Gestisci Camere</a>
            </nav>
        </aside>

        <main class="admin-content">
            <div class="admin-dashboard-view">
                <header class="admin-header">
                    <h1>Pannello Prenotazioni</h1>
                    <p>Gestisci le prenotazioni dell'hotel e gli stati dei pagamenti.</p>
                </header>

                <section class="metrics-grid">
                    <div class="metric-card">
                        <h3>Prenotazioni Totali</h3>
                        <p class="metric-value">{totalReservations}</p>
                    </div>
                    <div class="metric-card">
                        <h3>Pagamenti in Sospeso</h3>
                        <p class="metric-value">{pendingPayments}</p>
                    </div>
                    <div class="metric-card">
                        <h3>Tasso di Occupazione</h3>
                        <p class="metric-value">{occupancyRate}%</p>
                    </div>
                </section>

                <section class="reservations-section">
                    <AdminReservationsManager client:load />
                </section>
            </div>
        </main>
    </div>
</Layout>

<style>
    /* Note: Sidebar layout CSS is inherited globally from rooms.astro, so we only define local styles here */
    
    .admin-dashboard-view {
        background: transparent;
    }
    .admin-header {
        margin-bottom: 2.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .admin-header h1 {
        font-size: 2.5rem;
    }
    .metrics-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.5rem;
        margin-bottom: 3rem;
    }
    .metric-card {
        background: var(--primary);
        color: white;
        padding: 1.5rem;
        border-radius: var(--radius);
        box-shadow: var(--shadow);
    }
    .metric-card h3 {
        color: white;
        font-family: 'Montserrat', sans-serif;
        font-size: 1rem;
        font-weight: 500;
        opacity: 0.9;
        margin-bottom: 0.5rem;
    }
    .metric-value {
        font-size: 2.5rem;
        font-weight: 700;
        font-family: 'Cormorant', serif;
    }
    .reservations-section {
        background: var(--surface);
        padding: 2.5rem;
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        border: 1px solid var(--border);
    }
</style>
