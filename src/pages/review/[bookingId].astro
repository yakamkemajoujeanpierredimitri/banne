---
import Layout from '../../layouts/Layout.astro';
import { prisma } from '../../lib/prisma';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const { bookingId } = Astro.params;
const user = Astro.locals.user;

if (!user) {
    return Astro.redirect('/login');
}

const booking = await prisma.booking.findUnique({
    where: { id: bookingId, userId: user.id },
    include: { room: true }
});

if (!booking) {
    return Astro.redirect('/dashboard');
}

// Check if review already exists
const existingReview = await prisma.review.findFirst({
    where: { roomId: booking.roomId, guestName: user.name }
});

let message = '';

if (Astro.request.method === 'POST') {
    try {
        const data = await Astro.request.formData();
        const rating = parseInt(data.get('rating') as string);
        const comment = data.get('comment') as string;
        
        if (rating >= 1 && rating <= 5 && comment) {
            await prisma.review.create({
                data: {
                    rating,
                    comment,
                    guestName: user.name,
                    roomId: booking.roomId
                }
            });
            return Astro.redirect('/dashboard?reviewed=true');
        } else {
            message = 'Please provide a valid rating and comment.';
        }
    } catch (e) {
        message = 'Failed to submit review.';
    }
}
---

<Layout title={`Review your stay at ${booking.room.name}`}>
    <div class="container review-container">
        <h1>Review your stay at {booking.room.name}</h1>
        {existingReview ? (
            <div class="already-reviewed">
                <p>You have already reviewed this room!</p>
                <a href="/dashboard" class="btn">Back to Dashboard</a>
            </div>
        ) : (
            <form method="POST" class="review-form">
                {message && <p class="error">{message}</p>}
                
                <div class="form-group">
                    <label for="rating">Rating (1-5)</label>
                    <select name="rating" id="rating" required>
                        <option value="5">5 - Excellent</option>
                        <option value="4">4 - Very Good</option>
                        <option value="3">3 - Average</option>
                        <option value="2">2 - Poor</option>
                        <option value="1">1 - Terrible</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label for="comment">Your Comment</label>
                    <textarea name="comment" id="comment" rows="5" required></textarea>
                </div>
                
                <button type="submit" class="btn">Submit Review</button>
            </form>
        )}
    </div>
</Layout>

<style>
    .review-container {
        padding: 4rem 1rem;
        max-width: 600px;
        margin: 0 auto;
    }
    h1 {
        margin-bottom: 2rem;
        color: var(--primary);
    }
    .review-form {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }
    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    select, textarea {
        padding: 0.8rem;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        font-family: inherit;
    }
    .error {
        color: red;
        font-weight: bold;
    }
    .already-reviewed {
        text-align: center;
        padding: 2rem;
        background: var(--surface);
        border-radius: var(--radius);
    }
</style>
