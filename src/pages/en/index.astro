---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import logoImg from '../../assets/logo.jpg';
import heroImg from '../../assets/pic2.jpg';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<Layout title="Albergobanne Hotel - Experience Unparalleled Luxury">
	<div class="hero">
		<Image src={heroImg} alt="Hotel Hero" class="hero-bg" />
		<div class="hero-overlay"></div>
		<div class="hero-content container">
			<Image src={logoImg} alt="Albergobanne Logo" class="logo" />
			<h1>{t('hero.title')}</h1>
			<p>{t('hero.subtitle')}</p>
			<a href={translatePath('/rooms')} class="btn">{t('hero.cta')}</a>
		</div>
	</div>

	<section class="container features">
		<h2>{t('features.title')}</h2>
		<div class="feature-grid">
			<div class="feature-card">
				<h3>{t('feature.1.title')}</h3>
				<p>{t('feature.1.desc')}</p>
			</div>
			<div class="feature-card">
				<h3>{t('feature.2.title')}</h3>
				<p>{t('feature.2.desc')}</p>
			</div>
			<div class="feature-card">
				<h3>{t('feature.3.title')}</h3>
				<p>{t('feature.3.desc')}</p>
			</div>
		</div>
	</section>
</Layout>
