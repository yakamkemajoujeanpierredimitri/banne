---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import logoImg from '../../assets/logo.jpg';
import heroImg from '../../assets/pic2.jpg';
---

<Layout title="Albergobanne Hotel - Luxury Awaits">
	<div class="hero">
		<Image src={heroImg} alt="Hotel Hero" class="hero-bg" />
		<div class="hero-overlay"></div>
		<div class="hero-content container">
			<Image src={logoImg} alt="Albergobanne Logo" class="logo" />
			<h1>Welcome to Albergobanne</h1>
			<p>Experience unparalleled luxury and comfort in the heart of the city.</p>
			<a href="/en/rooms" class="btn">View Our Rooms</a>
		</div>
	</div>

	<section class="container features">
		<h2>Why Choose Us?</h2>
		<div class="feature-grid">
			<div class="feature-card">
				<h3>Premium Rooms</h3>
				<p>Relax in our elegantly designed suites equipped with top-tier amenities.</p>
			</div>
			<div class="feature-card">
				<h3>Fine Dining</h3>
				<p>Taste the world with our gourmet chefs and exclusive restaurant menus.</p>
			</div>
			<div class="feature-card">
				<h3>Spa & Wellness</h3>
				<p>Rejuvenate your body and mind in our state-of-the-art wellness center.</p>
			</div>
		</div>
	</section>
</Layout>

<style>
	/* Styles are inherited from the main index.astro component, but we can reuse the scoped ones here */
	.hero {
		position: relative;
		height: 80vh;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		color: white;
		margin-top: -80px; /* offset the nav bar */
		padding-top: 80px;
	}
	.hero-bg {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: -2;
	}
	.hero-overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(0, 0, 0, 0.6);
		z-index: -1;
	}
	.hero-content {
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
	}
	.logo {
		width: 120px;
		height: 120px;
		border-radius: 50%;
		object-fit: cover;
		margin-bottom: 1rem;
		border: 4px solid white;
		box-shadow: var(--shadow);
	}
	.hero h1 {
		font-size: clamp(2.5rem, 5vw, 4.5rem);
		color: white;
		margin-bottom: 0.5rem;
		letter-spacing: -0.02em;
	}
	.hero p {
		font-size: clamp(1.2rem, 3vw, 1.5rem);
		margin-bottom: 2rem;
		max-width: 600px;
		color: rgba(255,255,255,0.9);
	}
	.features {
		padding: 6rem 1.5rem;
		text-align: center;
	}
	.features h2 {
		font-size: 2.5rem;
		margin-bottom: 3rem;
		color: var(--primary);
	}
	.feature-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2.5rem;
	}
	.feature-card {
		background: var(--surface);
		padding: 2.5rem 2rem;
		border-radius: var(--radius);
		box-shadow: var(--shadow);
		border: 1px solid var(--border);
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}
	.feature-card:hover {
		transform: translateY(-5px);
		box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
	}
	.feature-card h3 {
		font-size: 1.5rem;
		margin-bottom: 1rem;
		color: var(--primary);
	}
	.feature-card p {
		color: var(--text-muted);
	}
</style>
