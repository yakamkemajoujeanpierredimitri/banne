---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';
import { prisma } from '../../lib/prisma';
import Stripe from 'stripe';

const lang = Astro.locals.lang || "it";
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const sessionId = Astro.url.searchParams.get('session_id');
if (sessionId) {
  const stripeSecretKey = import.meta.env.STRIPE_SECRET_KEY ;
  if (stripeSecretKey) {
    const stripe = new Stripe(stripeSecretKey);
    try {
      const session = await stripe.checkout.sessions.retrieve(sessionId);
      if (session.payment_status === 'paid' && session.client_reference_id) {
        const bookingId = session.client_reference_id;
        const booking = await prisma.booking.findUnique({ where: { id: bookingId } });
        if (booking && booking.status !== 'Paid') {
          await prisma.booking.update({
            where: { id: bookingId },
            data: { status: 'Paid' }
          });
          
          try {
            const { sendBookingConfirmation } = await import('../../lib/email');
            await sendBookingConfirmation(bookingId);
          } catch (err) {
            console.error('Failed to send email confirmation on success page:', err);
          }
        }
      }
    } catch (error) {
      console.error('Failed to retrieve checkout session:', error);
    }
  }
}
---

<Layout title="Booking Successful | Albergobanne Hotel">
	<div class="container message-container">
		<div class="success-icon">✓</div>
		<h1>Payment Successful!</h1>
		<p>Thank you for booking with Albergobanne Hotel. Your reservation is confirmed.</p>
		<p>We look forward to welcoming you.</p>
		
		<div class="actions">
			<a href={translatePath('/dashboard')} class="btn">View My Bookings</a>
			<a href={translatePath('/')} class="btn btn-outline">Return to Home</a>
		</div>
	</div>
</Layout>

<style>
	.message-container {
		text-align: center;
		padding: 6rem 1rem;
		max-width: 600px;
		margin: 0 auto;
	}
	.success-icon {
		background: #4CAF50;
		color: white;
		width: 80px;
		height: 80px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 40px;
		margin: 0 auto 2rem;
	}
	h1 {
		font-size: 2.5rem;
		margin-bottom: 1rem;
		color: var(--primary);
	}
	p {
		font-size: 1.1rem;
		margin-bottom: 1rem;
		color: #555;
	}
	.actions {
		display: flex;
		gap: 1rem;
		justify-content: center;
		margin-top: 3rem;
	}
	.btn-outline {
		background: transparent;
		border: 2px solid var(--primary);
		color: var(--primary);
	}
	.btn-outline:hover {
		background: var(--primary);
		color: white;
	}
</style>
