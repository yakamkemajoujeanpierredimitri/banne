---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { prisma } from '../lib/prisma';
import pic4 from '../assets/pic4.jpg'; // We can remove this later when images are from DB
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = Astro.locals.lang || "it";
const t = useTranslations(lang);

// Require user
const user = Astro.locals.user;
if (!user) {
    return Astro.redirect('/login');
}

// Fetch bookings from DB
const rawBookings = await prisma.booking.findMany({
    where: { userId: user.id },
    include: { room: true },
    orderBy: { checkInDate: 'asc' }
});

const bookings = rawBookings.map(b => ({
    id: b.id,
    roomName: b.room?.name || 'Unknown Room',
    checkIn: b.checkInDate.toISOString().split('T')[0],
    checkOut: b.checkOutDate.toISOString().split('T')[0],
    status: b.status,
    image: b.room?.imageUrl || '/src/assets/pic4.jpg'
}));
---

<Layout title={`${t('dash.upcoming')} - Albergobanne`}>
    <div class="container dashboard">
        <header class="dashboard-header">
            <h1>{t('dash.welcome')} {user.name}</h1>
            <p>{t('dash.subtitle')}</p>
        </header>

        <div class="dashboard-grid">
            <aside class="profile-card">
                <div class="avatar">JD</div>
                <h2>{user.name}</h2>
                <p>{user.email}</p>
                <p class="member-tag">{t('dash.member')} {new Date(user.createdAt).getFullYear()}</p>
                <form method="POST" action="/api/auth/logout" style="width: 100%;">
                    <button type="submit" class="btn logout-btn" style="width: 100%;">{t('dash.logout')}</button>
                </form>
            </aside>

            <main class="bookings-section">
                <h2>{t('dash.upcoming')}</h2>
                {bookings.length > 0 ? (
                    <div class="booking-list">
                        {bookings.map(booking => (
                            <div class="booking-card">
                                <div class="booking-img-wrapper">
                                    <img src={booking.image} alt={booking.roomName} class="booking-img" />
                                </div>
                                <div class="booking-info">
                                    <div class="booking-header">
                                        <h3>{booking.roomName}</h3>
                                        <span class="status-badge">{booking.status}</span>
                                    </div>
                                    <p><strong>{t('dash.bookingId')}</strong> {booking.id}</p>
                                    <p><strong>{t('dash.checkIn')}</strong> {booking.checkIn}</p>
                                    <p><strong>{t('dash.checkOut')}</strong> {booking.checkOut}</p>
                                    <div class="booking-actions">
                                        <button class="btn btn-outline">{t('dash.viewDetails')}</button>
                                        {booking.status === 'Paid' ? (
                                            <a href={`/review/${booking.id}`} class="btn btn-outline" style="border-color: #FFD700; color: #b89b00;">{t('dash.leaveReview')}</a>
                                        ) : (
                                            <button class="btn btn-danger">{t('dash.cancel')}</button>
                                        )}
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>
                ) : (
                    <p class="no-bookings">{t('dash.noBookings')} <a href="/rooms">{t('dash.explore')}</a> {t('dash.planNext')}</p>
                )}
            </main>
        </div>
    </div>
</Layout>

<style>
    .dashboard {
        padding: 4rem 1.5rem;
    }
    .dashboard-header {
        margin-bottom: 3rem;
    }
    .dashboard-header h1 {
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
    }
    .dashboard-grid {
        display: grid;
        grid-template-columns: 300px 1fr;
        gap: 3rem;
    }
    
    @media (max-width: 900px) {
        .dashboard-grid {
            grid-template-columns: 1fr;
        }
    }

    /* Profile Card */
    .profile-card {
        background: var(--surface);
        padding: 2rem;
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        border: 1px solid var(--border);
        text-align: center;
        height: fit-content;
    }
    .avatar {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: var(--primary);
        color: white;
        font-size: 2rem;
        font-family: 'Cormorant', serif;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem;
    }
    .profile-card h2 {
        font-size: 1.5rem;
        margin-bottom: 0.5rem;
    }
    .member-tag {
        color: var(--secondary);
        font-weight: 600;
        margin: 1rem 0 2rem;
        font-size: 0.9rem;
    }
    .logout-btn {
        width: 100%;
        background-color: var(--primary);
    }
    .logout-btn:hover {
        background-color: #1e40af;
    }

    /* Bookings */
    .bookings-section h2 {
        font-size: 2rem;
        margin-bottom: 1.5rem;
    }
    .booking-list {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }
    .booking-card {
        display: flex;
        background: var(--surface);
        border-radius: var(--radius);
        overflow: hidden;
        box-shadow: var(--shadow);
        border: 1px solid var(--border);
    }
    .booking-img-wrapper {
        width: 200px;
        flex-shrink: 0;
    }
    .booking-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .booking-info {
        padding: 1.5rem;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .booking-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 0.5rem;
    }
    .booking-header h3 {
        font-size: 1.25rem;
        margin: 0;
    }
    .status-badge {
        background: #e8f5e9;
        color: #2e7d32;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
    }
    .booking-actions {
        display: flex;
        gap: 1rem;
        margin-top: 1.5rem;
    }
    .btn-outline {
        background: transparent;
        color: var(--primary);
        border: 1px solid var(--primary);
    }
    .btn-outline:hover {
        background: var(--primary);
        color: white;
    }
    .btn-danger {
        background: #ef4444;
    }
    .btn-danger:hover {
        background: #dc2626;
    }
    
    @media (max-width: 600px) {
        .booking-card {
            flex-direction: column;
        }
        .booking-img-wrapper {
            width: 100%;
            height: 200px;
        }
    }
</style>
