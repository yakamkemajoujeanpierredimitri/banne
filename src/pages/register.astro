---
import Layout from '../layouts/Layout.astro';
import { prisma } from '../lib/prisma';
import { createSession } from '../lib/auth';
import crypto from 'crypto';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = Astro.locals.lang || "it";
const t = useTranslations(lang);

let error = '';

if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const name = data.get('name')?.toString();
  const email = data.get('email')?.toString();
  const password = data.get('password')?.toString();

  if (name && email && password) {
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(email)) {
      error = lang === 'it' ? 'Indirizzo email non valido' : 
              lang === 'fr' ? 'Adresse email invalide' :
              lang === 'nl' ? 'Ongeldig e-mailadres' :
              'Invalid email address';
    } else {
      const existing = await prisma.user.findUnique({ where: { email } });
      if (existing) {
        error = lang === 'it' ? 'Email già registrata' :
                lang === 'fr' ? 'Email déjà enregistré' :
                lang === 'nl' ? 'E-mail is al geregistreerd' :
                'Email is already registered';
      } else {
        const passwordHash = crypto.createHash('sha256').update(password).digest('hex');
        
        const user = await prisma.user.create({
          data: {
            name,
            email,
            password: passwordHash,
            role: 'GUEST'
          }
        });

        const session = await createSession(user.id);
        Astro.cookies.set('auth_session', session.id, {
          path: '/',
          httpOnly: true,
          sameSite: 'lax',
          expires: session.expiresAt
        });
        return Astro.redirect('/dashboard');
      }
    }
  } else {
    error = lang === 'it' ? 'Si prega di compilare tutti i campi' :
            lang === 'fr' ? 'Veuillez remplir tous les champs' :
            lang === 'nl' ? 'Vul alstublieft alle velden in' :
            'Please fill out all fields';
  }
}
---

<Layout title={`${t('register.title')} - Albergobanne`}>
  <div class="auth-container container">
    <div class="auth-card">
      <h1>{t('register.title')}</h1>
      <p>{t('register.subtitle')}</p>
      
      {error && <div class="error-alert">{error}</div>}
      
      <form method="POST" class="auth-form">
        <div class="form-group">
          <label for="name">{t('register.name')}</label>
          <input type="text" id="name" name="name" required />
        </div>
        <div class="form-group">
          <label for="email">{t('register.email')}</label>
          <input type="email" id="email" name="email" required pattern="^[^\s@]+@[^\s@]+\.[^\s@]+$" title="Valid email required" />
        </div>
        <div class="form-group">
          <label for="password">{t('register.password')}</label>
          <input type="password" id="password" name="password" required minlength="6" />
        </div>
        <button type="submit" class="btn">{t('register.submit')}</button>
      </form>
      <div class="auth-links">
        <p>{t('register.hasAccount')} <a href="/login">{t('register.loginLink')}</a></p>
      </div>
    </div>
  </div>
</Layout>

<style>
  .auth-container {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 70vh;
    padding: 2rem;
  }
  .auth-card {
    background: var(--surface);
    padding: 3rem;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    border: 1px solid var(--border);
    width: 100%;
    max-width: 450px;
    text-align: center;
  }
  .auth-card h1 {
    font-size: 2rem;
    color: var(--primary);
    margin-bottom: 0.5rem;
  }
  .auth-card p {
    color: var(--text-muted);
    margin-bottom: 2rem;
  }
  .error-alert {
    background: #fee2e2;
    color: #991b1b;
    padding: 1rem;
    border-radius: 4px;
    margin-bottom: 1.5rem;
  }
  .auth-form {
    text-align: left;
  }
  .form-group {
    margin-bottom: 1.5rem;
  }
  .form-group label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 600;
  }
  .form-group input {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: 4px;
  }
  .btn {
    width: 100%;
    padding: 1rem;
    font-size: 1.1rem;
    margin-bottom: 1.5rem;
  }
  .auth-links a {
    color: var(--primary);
    font-weight: 600;
  }
</style>
