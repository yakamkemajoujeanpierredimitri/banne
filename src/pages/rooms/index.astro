---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { prisma } from '../../lib/prisma';

// Fetch rooms from database
const rooms = await prisma.room.findMany({
  where: { isAvailable: true }
});
---

<Layout title="Our Rooms - Albergobanne">
  <div class="container rooms-page">
    <header class="page-header">
      <h1>Our Rooms</h1>
      <p>Find the perfect space for your stay.</p>
    </header>

    <div class="rooms-grid">
      {rooms.map(room => (
        <div class="room-card">
          <div class="img-wrapper">
             <img src={room.imageUrl} alt={room.name} class="room-img" />
          </div>
          <div class="room-content">
            <h2>{room.name}</h2>
            <p class="price">${room.price} / night</p>
            <p class="desc">{room.description}</p>
            <a href={`/rooms/${room.id}`} class="btn view-btn">View Details</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>

<style>
  .rooms-page {
    padding: 4rem 1.5rem;
  }
  .page-header {
    text-align: center;
    margin-bottom: 4rem;
  }
  .page-header h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
  }
  .rooms-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2.5rem;
  }
  .room-card {
    background: var(--surface);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
  }
  .img-wrapper {
    width: 100%;
    height: 250px;
  }
  .room-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .room-content {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .room-content h2 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .price {
    font-weight: 600;
    color: var(--secondary);
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }
  .desc {
    color: var(--text-muted);
    margin-bottom: 2rem;
    flex-grow: 1;
  }
  .view-btn {
    text-align: center;
    width: 100%;
  }
</style>
