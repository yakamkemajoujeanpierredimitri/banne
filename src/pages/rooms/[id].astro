---
import Layout from '../../layouts/Layout.astro';
import BookingWidget from '../../components/BookingWidget.jsx';
import ImageGallery from '../../components/ImageGallery.jsx';
import { prisma } from '../../lib/prisma';

const { id } = Astro.params;

if (!id) {
    return Astro.redirect('/404');
}

const room = await prisma.room.findUnique({
  where: { id }
});

if (!room) {
    return Astro.redirect('/404');
}

// Temporary: create an array of images from the single imageUrl for the gallery
const images = [room.imageUrl];

const existingBookings = await prisma.booking.findMany({
    where: { 
        roomId: room.id,
        status: { not: 'Cancelled' },
        checkOutDate: { gte: new Date() }
    },
    select: { checkInDate: true, checkOutDate: true }
});

const blockedDates = existingBookings.map(b => ({
    from: b.checkInDate.toISOString().split('T')[0],
    to: b.checkOutDate.toISOString().split('T')[0]
}));
---

<Layout title={`${room.name} - Albergobanne`}>
  <div class="container room-detail-page">
    <div class="content-grid">
      
      <div class="main-content">
        <header>
            <h1>{room.name}</h1>
            <p class="desc">{room.description}</p>
        </header>

        <section class="gallery-section">
            <ImageGallery client:load images={images} />
        </section>

        <section class="amenities">
            <h2>Room Amenities</h2>
            {room.amenities && room.amenities.length > 0 ? (
                <ul>
                    {room.amenities.map(amenity => (
                        <li>{amenity}</li>
                    ))}
                </ul>
            ) : (
                <p>No specific amenities listed for this room.</p>
            )}
        </section>
      </div>

      <aside class="sidebar">
        <BookingWidget client:load price={room.price} roomId={room.id} blockedDates={blockedDates} />
      </aside>

    </div>
  </div>
</Layout>

<style is:global>
  .room-detail-page {
    padding: 4rem 1.5rem;
  }
  .content-grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 3rem;
    align-items: start;
  }
  
  @media (max-width: 900px) {
      .content-grid {
          grid-template-columns: 1fr;
      }
  }

  .main-content h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
  }
  .main-content .desc {
    font-size: 1.25rem;
    color: var(--text-muted);
    margin-bottom: 3rem;
  }

  .gallery-section {
    margin-bottom: 4rem;
  }

  .amenities h2 {
      margin-bottom: 1.5rem;
  }
  .amenities ul {
      list-style-position: inside;
      line-height: 2;
      color: var(--text-main);
  }

  /* Image Gallery Styles */
  .image-gallery {
      display: flex;
      flex-direction: column;
      gap: 1rem;
  }
  .main-image-container {
      position: relative;
      border-radius: var(--radius);
      overflow: hidden;
      height: 400px;
      background: #000;
  }
  .main-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
  }
  .gallery-nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      background: rgba(255, 255, 255, 0.8);
      color: var(--primary);
      border: none;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      font-size: 1.2rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.2s;
  }
  .gallery-nav:hover {
      background: white;
  }
  .gallery-nav.prev { left: 1rem; }
  .gallery-nav.next { right: 1rem; }
  
  .thumbnail-strip {
      display: flex;
      gap: 1rem;
      overflow-x: auto;
  }
  .thumbnail {
      width: 80px;
      height: 60px;
      object-fit: cover;
      border-radius: 4px;
      cursor: pointer;
      opacity: 0.6;
      transition: opacity 0.2s;
  }
  .thumbnail:hover, .thumbnail.active {
      opacity: 1;
      border: 2px solid var(--secondary);
  }

  /* Booking Widget Styles */
  .booking-widget {
      background: var(--surface);
      padding: 2rem;
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      border: 1px solid var(--border);
      position: sticky;
      top: 2rem;
  }
  .booking-widget h3 {
      font-size: 1.5rem;
      margin-bottom: 0.5rem;
  }
  .price-info {
      color: var(--secondary);
      font-weight: 600;
      margin-bottom: 2rem;
  }
  .form-group {
      margin-bottom: 1.5rem;
  }
  .form-group label {
      display: block;
      margin-bottom: 0.5rem;
      font-weight: 500;
      font-size: 0.9rem;
  }
  .form-group input, .form-group select {
      width: 100%;
      padding: 0.75rem;
      border: 1px solid var(--border);
      border-radius: 4px;
      font-family: inherit;
  }
  .book-btn {
      width: 100%;
      margin-top: 1rem;
  }
  .success-message {
      padding: 2rem;
      background: #e8f5e9;
      color: #2e7d32;
      border-radius: 4px;
      text-align: center;
  }
</style>
