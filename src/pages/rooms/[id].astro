---
import Layout from '../../layouts/Layout.astro';
import BookingWidget from '../../components/BookingWidget.jsx';
import ImageGallery from '../../components/ImageGallery.jsx';

export function getStaticPaths() {
  // Mock IDs for the static generation
  return [
    { params: { id: '1' } },
    { params: { id: '2' } },
    { params: { id: '3' } }
  ];
}

const { id } = Astro.params;

// Mock data mapping
const roomsData = {
  '1': { name: 'Deluxe Suite', price: 250, description: 'A gorgeous deluxe suite with a king-size bed, premium amenities, and a stunning view of the city skyline. Perfect for a romantic getaway.', images: ['/src/assets/pic4.jpg', '/src/assets/pic7.jpg'] },
  '2': { name: 'Standard Room', price: 150, description: 'A cozy standard room featuring modern decor, a comfortable queen bed, and a spacious work desk for business travelers.', images: ['/src/assets/pic5.jpg', '/src/assets/pic8.jpg'] },
  '3': { name: 'Family Room', price: 300, description: 'A massive family room equipped with two queen beds, a living area, and special welcome kits for children.', images: ['/src/assets/pic6.jpg', '/src/assets/pic2.jpg'] },
};

const room = roomsData[id];

if (!room) {
    return Astro.redirect('/404');
}
---

<Layout title={`${room.name} - Albergobanne`}>
  <div class="container room-detail-page">
    <div class="content-grid">
      
      <div class="main-content">
        <header>
            <h1>{room.name}</h1>
            <p class="desc">{room.description}</p>
        </header>

        <section class="gallery-section">
            <ImageGallery client:load images={room.images} />
        </section>

        <section class="amenities">
            <h2>Room Amenities</h2>
            <ul>
                <li>Free High-Speed Wi-Fi</li>
                <li>Flat-screen TV with streaming services</li>
                <li>Mini-bar & Coffee maker</li>
                <li>Premium bath products</li>
                <li>24/7 Room Service</li>
            </ul>
        </section>
      </div>

      <aside class="sidebar">
        <BookingWidget client:load price={room.price} />
      </aside>

    </div>
  </div>
</Layout>

<style is:global>
  .room-detail-page {
    padding: 4rem 1.5rem;
  }
  .content-grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 3rem;
    align-items: start;
  }
  
  @media (max-width: 900px) {
      .content-grid {
          grid-template-columns: 1fr;
      }
  }

  .main-content h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
  }
  .main-content .desc {
    font-size: 1.25rem;
    color: var(--text-muted);
    margin-bottom: 3rem;
  }

  .gallery-section {
    margin-bottom: 4rem;
  }

  .amenities h2 {
      margin-bottom: 1.5rem;
  }
  .amenities ul {
      list-style-position: inside;
      line-height: 2;
      color: var(--text-main);
  }

  /* Image Gallery Styles */
  .image-gallery {
      display: flex;
      flex-direction: column;
      gap: 1rem;
  }
  .main-image-container {
      position: relative;
      border-radius: var(--radius);
      overflow: hidden;
      height: 400px;
      background: #000;
  }
  .main-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
  }
  .gallery-nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      background: rgba(255, 255, 255, 0.8);
      color: var(--primary);
      border: none;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      font-size: 1.2rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.2s;
  }
  .gallery-nav:hover {
      background: white;
  }
  .gallery-nav.prev { left: 1rem; }
  .gallery-nav.next { right: 1rem; }
  
  .thumbnail-strip {
      display: flex;
      gap: 1rem;
      overflow-x: auto;
  }
  .thumbnail {
      width: 80px;
      height: 60px;
      object-fit: cover;
      border-radius: 4px;
      cursor: pointer;
      opacity: 0.6;
      transition: opacity 0.2s;
  }
  .thumbnail:hover, .thumbnail.active {
      opacity: 1;
      border: 2px solid var(--secondary);
  }

  /* Booking Widget Styles */
  .booking-widget {
      background: var(--surface);
      padding: 2rem;
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      border: 1px solid var(--border);
      position: sticky;
      top: 2rem;
  }
  .booking-widget h3 {
      font-size: 1.5rem;
      margin-bottom: 0.5rem;
  }
  .price-info {
      color: var(--secondary);
      font-weight: 600;
      margin-bottom: 2rem;
  }
  .form-group {
      margin-bottom: 1.5rem;
  }
  .form-group label {
      display: block;
      margin-bottom: 0.5rem;
      font-weight: 500;
      font-size: 0.9rem;
  }
  .form-group input, .form-group select {
      width: 100%;
      padding: 0.75rem;
      border: 1px solid var(--border);
      border-radius: 4px;
      font-family: inherit;
  }
  .book-btn {
      width: 100%;
      margin-top: 1rem;
  }
  .success-message {
      padding: 2rem;
      background: #e8f5e9;
      color: #2e7d32;
      border-radius: 4px;
      text-align: center;
  }
</style>
