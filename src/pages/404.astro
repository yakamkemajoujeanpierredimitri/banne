---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found - Albergobanne">
    <div class="container error-page">
        <div class="error-content">
            <h1>404</h1>
            <h2>Page Not Found</h2>
            <p>We're sorry, the page you're looking for doesn't exist or has been moved.</p>
            <a href="/" class="btn">Return to Homepage</a>
        </div>
    </div>
</Layout>

<style>
    .error-page {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 60vh;
        text-align: center;
    }
    .error-content h1 {
        font-size: 8rem;
        color: var(--primary);
        margin-bottom: 0;
        line-height: 1;
    }
    .error-content h2 {
        font-size: 2rem;
        margin-bottom: 1rem;
        color: var(--text-main);
    }
    .error-content p {
        font-size: 1.1rem;
        color: var(--text-muted);
        margin-bottom: 2rem;
    }
</style>
